# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/autonomous_admissions

# Authentication
JWT_SECRET=dev_secret_key_autonomous_admissions_platform_2026
JWT_EXPIRES_IN=7d

# AWS Configuration (Leave blank for automatic local dev fallback)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=admissions-student-documents-prod
AWS_SES_FROM_EMAIL=admissions@university.edu
AWS_SQS_DOCUMENT_QUEUE_URL=
AWS_SQS_NOTIFICATION_QUEUE_URL=
AWS_EC2_INSTANCE_ID=

# AWS Cost Protection & Emergency Shutdown Thresholds (USD)
AWS_BUDGET_LIMIT=96.87
AWS_WARNING_THRESHOLD=50
AWS_CRITICAL_THRESHOLD=60
AWS_EMERGENCY_THRESHOLD=70

# Cost Simulation & Testing Mode (Set to true to enable manual simulation without incurring AWS cost)
AWS_COST_PROTECTION_TEST_MODE=true
AWS_SIMULATED_COST=0
AWS_COST_CHECK_INTERVAL_MS=60000

# Application Usage Limits (Defense Layer 2)
MAX_TEXTRACT_DOCUMENTS=100
MAX_EMAILS=500
MAX_AWS_OPERATIONS=2000
MAX_SQS_MESSAGES=1000
MAX_LAMBDA_OPERATIONS=500
MAX_RETRIES=3

# AI Agent & LLM Credentials
AI_SECRET_KEY=ai_internal_token_secret_key_2026
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API (Optional)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=verify_admissions_token
